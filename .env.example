# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
DEBUG_MODE=false
ENABLE_DIAGNOSTICS=false

# Database
DB_PATH=./storage/riws.db

# Media Storage
MEDIA_STORAGE_PATH=./storage/events

# VLM Configuration
VLM_PROVIDER=mock
VLM_DEPLOYMENT_MODE=MOCK
VLM_API_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_MS=15000
VLM_MAX_RETRIES=2
VLM_PROMPT_VERSION=riws-v1
VLM_IMAGE_MAX_WIDTH=1280
VLM_IMAGE_JPEG_QUALITY=85
VLM_MAX_IMAGES_PER_REQUEST=6
VLM_INCLUDE_ANNOTATED_IMAGE=true
VLM_INCLUDE_ORIGINAL_IMAGE=true

# RIWS Settings
REQUIRE_AUTHORIZATION_CONFIRMATION=false
REQUIRE_RESET_CONFIRMATION=false
AUTO_CLOSE_EVENT_ON_PANEL_RESET=true
INCURSION_FLASH_MODE=steady
